{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "cluesbysam",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "cluesbysam.net/*",
      "zone_name": "cluesbysam.net"
    },
    {
      "pattern": "www.cluesbysam.net/*",
      "zone_name": "cluesbysam.net"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  }
}
